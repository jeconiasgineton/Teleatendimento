{
  "expo": {
    "name": "TalkDay",
    "slug": "talkday",
    "scheme": "talkday",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.talkday.app"
    },
    "android": {
      "package": "com.talkday.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "color": "#58CC02"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "O TalkDay usa o microfone para você praticar falando inglês.",
          "speechRecognitionPermission": "O TalkDay usa o reconhecimento de fala para entender suas frases em inglês.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ]
  }
}
